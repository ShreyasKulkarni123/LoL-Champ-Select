{
  "name": "lol-champ-select-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop companion that bridges the local League Client (LCU) API to the mobile app",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "mock": "tsx src/mock/index.ts",
    "dev:mock": "tsx src/mock/index.ts --with-companion",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
